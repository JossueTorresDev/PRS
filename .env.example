@# Configuración de Supabase
# Obtén estos valores de tu proyecto en https://supabase.com/dashboard/project/_/settings/api

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/Public Key (clave pública)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Instrucciones de configuración:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores con tus credenciales reales de Supabase
# 3. En Supabase, crea un bucket llamado 'asset-documents'
# 4. Configura las policies del bucket para permitir lectura pública y escritura autenticada

# Gateway API (storage común y microservicios)
VITE_GATEWAY_API_URL=https://lab.vallegrande.edu.pe/gateway/api/v1

# URL del microservicio de configuración (ms-03-configuration) - Dokploy
VITE_CONFIGURATION_API_URL=https://lab.vallegrande.edu.pe/configuration

# URL del microservicio de movimientos (ms-05-movements) - Dokploy
VITE_MOVEMENT_API_URL=https://lab.vallegrande.edu.pe/movement
